{
  "name": "indoor-nav",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "admin": "npm run build && vite preview",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-mock": "node scripts/gen-mock.mjs",
    "eval:positioning": "vitest run src/positioning/eval --mode eval --silent=false"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.5.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
